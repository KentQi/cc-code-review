{
  "name": "cc-code-review",
  "version": "1.18.7",
  "description": "MCP server (cc-code-review) that calls Claude Code's native /code-review (or a fleet pipeline mirroring its playbook: parallel finder subagents, one verifier per surviving candidate, sweep; 0-100 confidence scoring, >=75 filter) and returns the findings to ZCode or any other MCP client.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cc-code-review": "src/index.js"
  },
  "license": "MIT",
  "author": {
    "name": "KentQi",
    "url": "https://github.com/KentQi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KentQi/cc-code-review.git"
  },
  "bugs": {
    "url": "https://github.com/KentQi/cc-code-review/issues"
  },
  "homepage": "https://github.com/KentQi/cc-code-review#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "claude",
    "code-review",
    "zcode",
    "cc-switch"
  ],
  "files": [
    "src",
    "scripts/pre-tool-hook.js",
    "scripts/init.mjs",
    "assets",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "init": "node scripts/init.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "validate": "node scripts/validation-test.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/cross-cases.mjs",
    "test:e2e:real": "node scripts/e2e-test.mjs",
    "test:followup": "node scripts/followup-e2e.mjs",
    "test:cancel": "node scripts/cancel-test.mjs",
    "test:pack": "node scripts/pack-test.mjs",
    "test:paid": "node scripts/paid-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  }
}
